# Served by Workers static assets (run_worker_first does not cover these paths).
# SPA shell must revalidate so a deploy picks up new hashed bundles.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable
