# ─── Library API auth (server secret + optional SPA bake) ───
# Protects /api/library when set. /favs + /import should use edge Access on private installs.
MUSIC_ACCESS_TOKEN=
# Optional build-time SPA token (avoid baking into public demo builds)
VITE_MUSIC_ACCESS_TOKEN=

# ─── Music gateway (server-side only — never put keys in the browser) ───
# You must use an API you are allowed to call. See docs/MUSIC-PROVIDERS.md
#
# Primary (default community free host — no apikey; not guaranteed):
CHKSZ_API_BASE=https://api.chksz.top
#
# Backup host (often needs apikey — comma-separated for round-robin):
CHKSZ_FALLBACK_BASE=https://api.chksz.com
CHKSZ_FALLBACK_APIKEYS=
# Optional alias used as a .com key if FALLBACK_APIKEYS empty:
# CHKSZ_APIKEY=
#
# Optional quality preference order (highest first)
# CHKSZ_QUALITY_LEVELS=jymaster,sky,jyeffect,hires,lossless,exhigh,higher,standard

# ─── Worker-only (also set via wrangler.toml [vars] / secrets) ───
# LIBRARY_READONLY=true
# LIBRARY_TOKEN_REQUIRED_HOSTS=music.example.com

# ─── Node / VPS / Docker ───
HOST=127.0.0.1
PORT=8787
MUSIC_DATA_DIR=./data

# ─── Smoke test (optional) ───
# SMOKE_BASE=http://127.0.0.1:8787
# SMOKE_DEMO=1
