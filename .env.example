# ─── Music gateway (server-side only — never put keys in the browser) ───
# You must use an API you are allowed to call. See docs/MUSIC-PROVIDERS.md
#
# Primary (api.chksz.top shut down — new host requires apikey):
CHKSZ_API_BASE=https://api.chksz.com
CHKSZ_APIKEY=
# Optional extra keys / second host:
# CHKSZ_FALLBACK_APIKEYS=key2,key3
# CHKSZ_FALLBACK_BASE=
#
# Optional quality preference order (highest first)
# CHKSZ_QUALITY_LEVELS=jymaster,sky,jyeffect,hires,lossless,exhigh,higher,standard

# ─── Worker-only (also set via wrangler.toml [vars] / secrets) ───
# LIBRARY_READONLY=true

# ─── Node / VPS / Docker ───
HOST=127.0.0.1
PORT=8787
MUSIC_DATA_DIR=./data

# ─── Smoke test (optional) ───
# SMOKE_BASE=http://127.0.0.1:8787
# SMOKE_DEMO=1
