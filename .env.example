# ─── ChKSz music gateway (server-side only — never expose to the browser) ───
#
# Primary (free, NO apikey):
CHKSZ_API_BASE=https://api.chksz.top

# Backup (paid, needs apikey — comma-separated for round-robin):
CHKSZ_FALLBACK_BASE=https://api.chksz.com
CHKSZ_FALLBACK_APIKEYS=chksz_key_one,chksz_key_two
# Optional alias (also treated as .com keys if FALLBACK_APIKEYS empty):
# CHKSZ_APIKEY=

# Optional quality preference order (highest first)
# CHKSZ_QUALITY_LEVELS=jymaster,sky,jyeffect,hires,lossless,exhigh,higher,standard

# ─── Node / VPS server ───
HOST=127.0.0.1
PORT=8787
MUSIC_DATA_DIR=./data

# ─── Smoke test (optional) ───
# SMOKE_BASE=http://127.0.0.1:8787
