{
  "name": "music-du",
  "version": "2.0.0",
  "private": true,
  "description": "Open-source personal music web app (Hono + React). Cloudflare Workers/D1 or Node/SQLite. Bring your own music API.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/sonnemusk/music-du.git"
  },
  "scripts": {
    "dev": "tsx watch server/node.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production tsx server/node.ts",
    "start:prod": "NODE_ENV=production node dist/server/node.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "setup:d1": "bash scripts/setup-d1.sh",
    "deploy:cf": "npm run build && wrangler deploy",
    "deploy:cf:demo": "npm run build && wrangler deploy --env demo",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "hono": "^4.7.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260810.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.0.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
